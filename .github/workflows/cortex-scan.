name: Cortex Cloud Security Scan

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  cortex-scan:
    name: Run Cortex IaC & Code Scan
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Cortex Code Security Scan
        uses: PaloAltoNetworks/cortex-cloud-scan@v1
        with:
          scan-type: code
          directory: .
          upload-mode: upload
